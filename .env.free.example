# Render API runtime: Neon application role, SSL enabled.
DATABASE_URL=postgresql://guardian_app:REPLACE_PASSWORD@YOUR-NEON-HOST/guardian?sslmode=require
# Neon schema-owner connection for startup Alembic migrations (not pooled).
MIGRATION_DATABASE_URL=postgresql://SCHEMA_OWNER:REPLACE_PASSWORD@YOUR-NEON-HOST/guardian?sslmode=require
DASHBOARD_DEV_MODE=0
STATIC_ONLY_MODE=1
DASHBOARD_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DASHBOARD_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
DASHBOARD_PUBLIC_BASE_URL=https://YOUR-API.onrender.com
DASHBOARD_WEB_BASE_URL=https://YOUR-PROJECT.vercel.app
# Optional GitHub App settings enable PR audits/checks; the dashboard OAuth
# GitHub client credentials are configured on Vercel for its sign-in flow.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_URL=
# Optional when using the paid queue profile; static-only never connects to Redis.
# REDIS_URL=rediss://default:REPLACE_PASSWORD@YOUR-UPSTASH-HOST:6379/0
