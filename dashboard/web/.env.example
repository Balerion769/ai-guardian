NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BACKEND_API_URL=http://127.0.0.1:8001
# GITHUB_ID=your-oauth-app-client-id
# GITHUB_SECRET=your-oauth-app-client-secret
# Checkout and portal URLs are created by the hosted API; never put Stripe secret keys here.
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=https://github.com/apps/ai-guardian/installations/new

# Vercel Hobby: set these in the project environment, then redeploy.
# NEXTAUTH_URL=https://YOUR-PROJECT.vercel.app
# NEXTAUTH_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
# GITHUB_ID=your-github-oauth-app-client-id
# GITHUB_SECRET=your-github-oauth-app-client-secret
# BACKEND_API_URL=https://YOUR-API.onrender.com
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com
# NEXT_PUBLIC_API_URL is a server-side fallback for BACKEND_API_URL.
# Browser traffic stays on /api/dashboard to keep the signed backend cookie private.
# DATABASE_URL, REDIS_URL, STATIC_ONLY_MODE, and encryption secrets belong on Render,
# not in NEXT_PUBLIC_* variables. No external LLM API is required.
